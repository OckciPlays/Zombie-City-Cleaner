--- !u!114 &1122723742
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1122723741}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: db7d61b440a190a4abd1f9479a308390, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ZombieCityCleaner.Chefes.VitrineDosChefes
  itens:
  - titulo: O Oco (escala)
    detalhes: O zumbi comum, 1,8 m.
    raiz: {fileID: 8908234143347250559}
  - titulo: O Blindado
    detalhes: "7,7 m  \xB7  19.889 tri\xE2ngulos  \xB7  147 ossos\nFus\xE3o de v\xE1rios Ocos: ombros assim\xE9tricos, a m\xE3o de agarr\xE3o, placas de calo. Divide-se nos Agregados A e B."
    raiz: {fileID: 1190704366}
  - titulo: "Agregado M\xE9dio A"
    detalhes: "4,0 m  \xB7  9.804 tri\xE2ngulos  \xB7  115 ossos\nMetade do Blindado: curvado, um segundo tronco no ombro, a m\xE3o de carne que estica (direita)."
    raiz: {fileID: 1403294552}
  - titulo: "Agregado M\xE9dio B"
    detalhes: "3,5 m  \xB7  9.841 tri\xE2ngulos  \xB7  106 ossos\nA outra metade: alto e ereto, a m\xE3o de carne que estica (esquerda)."
    raiz: {fileID: 1775934957}
  - titulo: O Alongado
    detalhes: "8,8 m  \xB7  17.503 tri\xE2ngulos  \xB7  124 ossos\nBra\xE7os humanos esticados (o esquerdo com um cotovelo a mais), membros extras nas costas."
    raiz: {fileID: 640959604}
  - titulo: O Longo
    detalhes: "2,9 m  \xB7  9.516 tri\xE2ngulos  \xB7  118 ossos\nO que sobra do Alongado: agachado, pesco\xE7o em S, a boca de \xE1cido; fundido com outros Ocos e Longs."
    raiz: {fileID: 1886168251}
  - titulo: O Condutor
    detalhes: "9,1 m  \xB7  20.519 tri\xE2ngulos  \xB7  178 ossos\nA torre de corpos, dezenas de bra\xE7os e o \xFAnico rosto humano (no peito, gritando)."
    raiz: {fileID: 1295974216}
  cameraDaCena: {fileID: 1190450776}
